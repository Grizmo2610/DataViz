{
  "tools": [
    {
      "name": "read_sample",
      "module": "dataviz.tools.reader_tools",
      "description": "Read a small row sample from a file",
      "args": [
        "file_path",
        "n_rows"
      ],
      "arg_types": {
        "file_path": "str",
        "n_rows": "int"
      },
      "agent": "reader"
    },
    {
      "name": "detect_schema",
      "module": "dataviz.tools.reader_tools",
      "description": "Detect column schema from a DataFrame",
      "args": [
        "df"
      ],
      "arg_types": {
        "df": "Any"
      },
      "agent": "reader"
    },
    {
      "name": "read_full_stats",
      "module": "dataviz.tools.reader_tools",
      "description": "Read full statistics from a file",
      "args": [
        "file_path"
      ],
      "arg_types": {
        "file_path": "str"
      },
      "agent": "reader"
    },
    {
      "name": "compute_descriptive_stats",
      "module": "dataviz.tools.eda_tools",
      "description": "Compute descriptive statistics for numeric columns",
      "args": [
        "df"
      ],
      "arg_types": {
        "df": "Any"
      },
      "agent": "eda"
    },
    {
      "name": "detect_nulls",
      "module": "dataviz.tools.eda_tools",
      "description": "Compute null counts and percentages per column",
      "args": [
        "df"
      ],
      "arg_types": {
        "df": "Any"
      },
      "agent": "eda"
    },
    {
      "name": "compute_correlation",
      "module": "dataviz.tools.eda_tools",
      "description": "Compute correlation matrix for numeric columns",
      "args": [
        "df",
        "method"
      ],
      "arg_types": {
        "df": "Any",
        "method": "str"
      },
      "agent": "eda"
    },
    {
      "name": "detect_time_series",
      "module": "dataviz.tools.eda_tools",
      "description": "Detect datetime columns using dtype + parse attempt",
      "args": [
        "df"
      ],
      "arg_types": {
        "df": "Any"
      },
      "agent": "eda"
    },
    {
      "name": "detect_outliers",
      "module": "dataviz.tools.eda_tools",
      "description": "Detect outliers using IQR fence method",
      "args": [
        "df"
      ],
      "arg_types": {
        "df": "Any"
      },
      "agent": "eda"
    },
    {
      "name": "auto_select_charts",
      "module": "dataviz.tools.viz_tools",
      "description": "Decide which chart types suit the dataset",
      "args": [
        "schema",
        "stats",
        "mode"
      ],
      "arg_types": {
        "schema": "dict",
        "stats": "dict",
        "mode": "str"
      },
      "agent": "viz"
    },
    {
      "name": "render_charts",
      "module": "dataviz.tools.viz_tools",
      "description": "Render chart spec descriptors into Vega-Lite JSON specs",
      "args": [
        "chart_specs",
        "df"
      ],
      "arg_types": {
        "chart_specs": "list",
        "df": "Any"
      },
      "agent": "viz"
    },
    {
      "name": "plot_histogram",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a histogram for a numeric column",
      "args": [
        "df",
        "col"
      ],
      "arg_types": {
        "df": "Any",
        "col": "str"
      },
      "agent": "viz"
    },
    {
      "name": "plot_scatter",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a scatter plot for two numeric columns",
      "args": [
        "df",
        "x",
        "y"
      ],
      "arg_types": {
        "df": "Any",
        "x": "str",
        "y": "str"
      },
      "agent": "viz"
    },
    {
      "name": "plot_bar",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a bar chart (categorical x, numeric y)",
      "args": [
        "df",
        "x",
        "y"
      ],
      "arg_types": {
        "df": "Any",
        "x": "str",
        "y": "str"
      },
      "agent": "viz"
    },
    {
      "name": "plot_line",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a line chart for time-series data",
      "args": [
        "df",
        "x",
        "y"
      ],
      "arg_types": {
        "df": "Any",
        "x": "str",
        "y": "str"
      },
      "agent": "viz"
    },
    {
      "name": "plot_boxplot",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a box-plot, optionally grouped",
      "args": [
        "df",
        "col"
      ],
      "arg_types": {
        "df": "Any",
        "col": "str"
      },
      "agent": "viz"
    },
    {
      "name": "plot_heatmap",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a correlation heatmap for numeric columns",
      "args": [
        "df"
      ],
      "arg_types": {
        "df": "Any"
      },
      "agent": "viz"
    },
    {
      "name": "plot_violin",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a violin / density plot",
      "args": [
        "df",
        "col"
      ],
      "arg_types": {
        "df": "Any",
        "col": "str"
      },
      "agent": "viz"
    },
    {
      "name": "plot_pie",
      "module": "dataviz.tools.viz_tools",
      "description": "Render a donut chart for a categorical column",
      "args": [
        "df",
        "col"
      ],
      "arg_types": {
        "df": "Any",
        "col": "str"
      },
      "agent": "viz"
    },
    {
      "name": "write_summary",
      "module": "dataviz.tools.report_tools",
      "description": "Write a dataset summary narrative",
      "args": [
        "schema",
        "stats",
        "lang"
      ],
      "arg_types": {
        "schema": "dict",
        "stats": "dict",
        "lang": "str"
      },
      "agent": "report"
    },
    {
      "name": "write_insights",
      "module": "dataviz.tools.report_tools",
      "description": "Derive key insights from EDA stats and rendered charts",
      "args": [
        "stats",
        "charts",
        "lang"
      ],
      "arg_types": {
        "stats": "dict",
        "charts": "list",
        "lang": "str"
      },
      "agent": "report"
    },
    {
      "name": "write_recommendations",
      "module": "dataviz.tools.report_tools",
      "description": "Derive actionable recommendations from insights",
      "args": [
        "insights",
        "lang"
      ],
      "arg_types": {
        "insights": "list",
        "lang": "str"
      },
      "agent": "report"
    },
    {
      "name": "assemble_dashboard",
      "module": "dataviz.tools.report_tools",
      "description": "Assemble all report sections into an HTML/PDF file",
      "args": [
        "sections",
        "template_name",
        "output_format",
        "out_dir",
        "lang"
      ],
      "arg_types": {
        "sections": "dict",
        "template_name": "str",
        "output_format": "str",
        "out_dir": "str",
        "lang": "str"
      },
      "agent": "report"
    },
    {
      "name": "detect_categorical_distributions",
      "module": "dataviz.tools.eda_tools",
      "description": "Return value counts for categorical columns",
      "args": [
        "df"
      ],
      "arg_types": {
        "df": "Any"
      },
      "agent": "eda"
    }
  ]
}